# Galipau App configuration (copy to .env and adjust). All values are optional.

# Address the server listens on. 127.0.0.1 = only this PC (default).
# 0.0.0.0 = also other devices on the local network (allow the Windows
# firewall prompt for PRIVATE networks only). Never open router ports.
# GALIPAU_HOST=127.0.0.1

# Port for `npm start` (default 4173)
# GALIPAU_PORT=4173

# Data folder. Default for real use: %LOCALAPPDATA%\GalipauApp
# Never place it inside OneDrive or another synced folder.
# GALIPAU_DATA_DIR=

# Local backups folder (default: <data folder>\copias)
# GALIPAU_BACKUP_DIR=

# Hours between automatic backups (default 24)
# GALIPAU_BACKUP_HOURS=24

# ---------------------------------------------------------------------------
# Backend used by the web app
#   local    -> local Express + SQLite server (default)
#   supabase -> Supabase (cloud). Use a TEST project for development.
# VITE_BACKEND=local

# Supabase project (only with VITE_BACKEND=supabase). Use ONLY the public
# (publishable / anon) key here: it is shipped to the browser by design and is
# not a security mechanism (access is protected by Auth + Row Level Security).
# NEVER put the service_role / secret key or the database password in this file.
# VITE_SUPABASE_URL=https://<test-project>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Product catalogue source for the quote form: "firebase" (legacy, default with
# the local backend), "local" (SQLite) or "supabase" (default with VITE_BACKEND=supabase).
# VITE_CATALOGO_FUENTE=firebase
